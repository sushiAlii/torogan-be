# Database Configuration
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=disable

# Redis Configuration
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Application Configuration
APP_PORT=8080
APP_ENV=development

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AWS S3 (property photo uploads via presigned PUT)
AWS_REGION=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS SES (email verification) — leave SES_FROM_ADDRESS blank in local dev to
# log verification links to stdout instead of sending real emails. Uses its
# own IAM credentials (a send-only identity, e.g. "torogan-ses-sender"),
# deliberately separate from the AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY pair
# above used for S3 uploads.
SES_FROM_ADDRESS=
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=

# Public URL of the frontend, used to build the email verification link
# (e.g. https://torogan.com). Defaults to http://localhost:3000 if unset.
PUBLIC_APP_URL=
